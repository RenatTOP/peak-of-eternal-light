# Cloudflare Pages: caching and basic security headers.
# Vite puts the hash in JS/CSS file names, so they can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Data (terrain, ephemeris, horizons) changes only with a new site version
/data/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
